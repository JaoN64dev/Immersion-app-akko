node_modules/
.env
*.log

# secrets that must never be tracked: wrangler's local ones (cloud/.dev.vars is where
# `wrangler dev` keeps GITHUB_TOKEN), and the ones the deploy step would otherwise pick up
.dev.vars
.dev.vars.*
.vars
*.pem
*.p12



dist/

# data/: only the dictionary files belong in the repository; the rest is what the server saves
# (your word list, logins, backups, caches…)
data/*
!data/dict.json
!data/kanji.json
!data/accents.txt

# akko's online service run locally (tools/cloud-local.mjs)
cloud-local/
