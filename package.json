{
  "name": "akko",
  "productName": "akko",
  "version": "1.9.0",
  "description": "Learn Japanese or English by immersion: watch, read and listen with a pop-up dictionary, grammar lessons and Anki mining.",
  "main": "electron/main.js",
  "author": "akko (JaoN64Dev)",
  "license": "MIT",
  "repository": "github:JaoN64dev/Immersion-app-akko",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "desktop": "node electron/run.js",
    "dist": "node tools/pack-extension.js && electron-builder --publish never",
    "test": "node --test \"tests/*.test.*\"",
    "check-lessons": "node tools/check-lessons.js",
    "pack-extension": "node tools/pack-extension.js"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "adm-zip": "^0.6.1",
    "cmu-pronouncing-dictionary": "^3.0.0",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "lindera-wasm-nodejs-ipadic": "2.0.0",
    "wordnet-db": "^3.1.14"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.jaon64dev.akko",
    "productName": "akko",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!data/**",
      "data/dict.json",
      "data/kanji.json",
      "data/accents.txt",
      "!dist/**",
      "!tests/**",
      "!tools/**",
      "!docs/**",
      "!*.bat",
      "!.github/**",
      "!website/**",
      "!extension/**",
      "!node_modules/@ffmpeg/core/dist/umd/**",
      "!node_modules/@ffmpeg/ffmpeg/dist/umd/**",
      "!node_modules/wordnet-db/dict/index.sense"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "akko-setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "akko-portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.png",
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.png",
      "category": "Education",
      "executableName": "akko",
      "synopsis": "Learn Japanese or English by immersion"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "JaoN64dev",
        "repo": "Immersion-app-akko"
      }
    ],
    "extraResources": [
      {
        "from": "extension",
        "to": "extension",
        "filter": [
          "**/*",
          "!README.md"
        ]
      }
    ],
    "electronLanguages": [
      "en-US",
      "pt-BR",
      "es",
      "ja"
    ],
    "dmg": {
      "artifactName": "akko-${version}-mac-${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "akko-${version}-linux-${arch}.${ext}"
    }
  }
}
